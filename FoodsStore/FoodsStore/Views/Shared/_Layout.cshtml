@using FoodsStore.Services
@inject FoodsStore.Services.ICartService CartService

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FoodsStore</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FoodsStore.styles.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        /* Bảng màu: Primary #FF8A00 (Cam), Secondary #3C6E71 (Xanh Lục Bảo), Background #F7F7F7, Text #282C34 */

        html, body {
            height: 100%;
        }

        body {
            background-color: #F7F7F7;
            font-family: 'Segoe UI', sans-serif;
            color: #282C34;
            display: flex;
            flex-direction: column;
        }

            body > .container.pt-5 {
                flex: 1;
            }

        /* Header (Giữ màu Xanh Lục Bảo Đậm và Fixed) */
        .navbar {
            background-color: #3C6E71;
        }

        .navbar-brand {
            font-weight: bold;
            font-size: 1.5rem;
            color: #FF8A00 !important;
        }

        /* ==== NÚT Ở THANH NAVBAR (PHẢI) ==== */

        /* Căn khoảng cách chung giữa các nút */
        .navbar-nav .btn-nav {
            border-radius: 8px;
            padding: 6px 18px;
            margin-left: 10px;
            font-weight: 500;
            border: none;
            transition: all 0.25s ease;
        }

        /* Giỏ hàng: vàng */
        .btn-cart {
            background-color: #FFC107;
            color: #000;
        }

            .btn-cart:hover {
                background-color: #E0A800;
                color: #fff !important;
            }

        /* Đăng ký: xanh lá */
        .btn-register {
            background-color: #00C853;
            color: #000 !important; /* chữ đen */
        }

            .btn-register:hover {
                background-color: #00A846;
                color: #fff !important; /* hover chữ trắng */
            }

        /* Đăng nhập: xanh dương ngọc */
        .btn-login {
            background-color: #00E5FF;
            color: #000 !important; /* chữ đen */
        }

            .btn-login:hover {
                background-color: #00C4E4;
                color: #fff !important; /* hover chữ trắng */
            }

        /* Nút hiển thị tên user */
        .btn-user {
            background-color: #FFFFFF;
            color: #3C6E71; /* xanh lục bảo */
            border: 2px solid #3C6E71;
            border-radius: 8px;
            padding: 6px 16px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.25s ease;
        }

            .btn-user:hover {
                background-color: #3C6E71;
                color: #FFFFFF;
            }

        /* Đăng xuất: đỏ */
        .btn-logout {
            background-color: #FFFFFF;
            color: #E63946; 
            border: 2px solid #E63946; 
            border-radius: 8px;
            padding: 6px 16px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.25s ease;
        }

            .btn-logout:hover {
                background-color: #E63946;
                color: #FFFFFF;
            }

        /* Khung lớn chứa nội dung (Container) - Viền nhẹ */
        .container {
            background-color: white;
            padding: 30px;
            border-radius: 12px;
            border: 2px solid #E0E0E0; /* Viền Xám Trắng nhẹ */
            box-shadow: 0 4px 12px rgba(40, 44, 52, 0.03);
        }

        footer {
            background-color: #3C6E71;
            color: #F7F7F7;
            padding: 20px;
            text-align: center;
            margin-top: 40px;
        }

        h2, h4 {
            color: #282C34;
        }

        /* Nút CTA chính (Đặt món) */
        .btn-success {
            background-color: #FF8A00;
            border-color: #FF8A00;
        }

            .btn-success:hover {
                background-color: #E57D00;
                border-color: #E57D00;
            }

        /* Thẻ thức ăn (Card) - Viền nhẹ */
        .card {
            background-color: white;
            border: 2px solid #E0E0E0; /* Viền Xám Trắng nhẹ */
            box-shadow: 0 4px 8px rgba(40, 44, 52, 0.05);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            border-radius: 12px;
            /* Đảm bảo các card trong 1 hàng có cùng chiều cao */
            height: 100%;
        }

            .card:hover {
                transform: translateY(-5px);
                border-color: #FF8A00; /* Viền Cam Rực Rỡ khi hover */
                box-shadow: 0 8px 16px rgba(255, 138, 0, 0.2);
            }

        .card-img-top {
            height: 180px;
            object-fit: cover;
            border-top-left-radius: 9px;
            border-top-right-radius: 9px;
            border-bottom: 2px solid #FF8A00; /* Đường phân cách Cam Rực Rỡ */
        }

        /* --- CSS SỬA LỖI LỆCH CARD --- */
        .card-body {
            /* Dùng Flexbox để căn chỉnh nội dung */
            display: flex;
            flex-direction: column;
            /* Chiều cao tối thiểu cho thân thẻ (bao gồm tiêu đề, mô tả, nút) */
            min-height: 200px;
        }

        .card-title {
            flex-grow: 0; /* Tiêu đề không co giãn */
        }

        .card-text {
            flex-grow: 1; /* Mô tả co giãn để lấp đầy không gian trống */
            overflow: hidden;
            /* Giới hạn nội dung tối đa 3 dòng và hiển thị dấu '...' */
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            text-overflow: ellipsis;
            margin-bottom: 10px;
        }

        /* Đẩy nút xuống dưới cùng của thẻ */
        .card-body .btn-success {
            margin-top: auto;
        }
        /* --- KẾT THÚC CSS SỬA LỖI LỆCH CARD --- */


        /* CSS cho Slideshow Banner */
        .banner-slideshow-container {
            max-width: 100%;
            position: relative;
            margin: 2rem auto;
            overflow: hidden;
        }

        .banner-slide {
            display: none;
        }

        .banner-box {
            background-color: #A9ECCE; /* Màu mint nhạt cho banner */
            border: 2px dashed #FF8A00; /* Viền Cam */
            border-radius: 12px;
            padding: 2rem;
            margin: 0;
            text-align: center;
            color: #282C34;
            font-size: 1.5rem;
            font-weight: 600;
        }

        .fade {
            animation-name: fade;
            animation-duration: 1.5s;
        }

        /* SỬA LỖI CÚ PHÁP RAZOR (Dùng @@keyframes) */
        @@keyframes fade {
            from {
                opacity: .4
            }

            to {
                opacity: 1
            }
        }
    </style>
</head>
<body>
    @{
        var cartCount = await CartService.GetCartCountAsync(User, Context);
    }

    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">FoodsStore</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse">
                    <!-- Menu trái -->
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>

                    <!-- Menu phải: Giỏ hàng + User / Auth -->
                    <ul class="navbar-nav ms-auto align-items-center">

                        <!-- Giỏ hàng: luôn có, giống nút vàng -->
                        <li class="nav-item">
                            <a class="btn btn-nav btn-cart d-flex align-items-center"
                               asp-page="/Cart/Index">
                                <i class="bi bi-cart3 me-2"></i>
                                Giỏ Hàng (@cartCount)
                            </a>
                        </li>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <!-- Nút tên user (trắng viền xanh) -->
                            <li class="nav-item ms-2">
                                <div class="btn btn-user">@User.Identity.Name</div>
                            </li>

                            <!-- Đăng xuất: nút đỏ, submit form POST -->
                            <li class="nav-item ms-2">
                                <button class="btn btn-logout"
                                        onclick="document.getElementById('logoutForm').submit();">
                                    Đăng xuất
                                </button>
                            </li>
                        }
                        else
                        {
                            <!-- Chưa login: Đăng ký (xanh lá) -->
                            <li class="nav-item">
                                <a class="btn btn-nav btn-register" href="/Account/Register">
                                    Đăng ký
                                </a>
                            </li>

                            <!-- Chưa login: Đăng nhập (xanh dương ngọc) -->
                            <li class="nav-item">
                                <a class="btn btn-nav btn-login" href="/Account/Login">
                                    Đăng nhập
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container pt-5">
        @RenderBody()
    </div>

    <footer>
        © 2025 FoodMenu | Thực phẩm sạch - Tươi ngon mỗi ngày
    </footer>

    <div class="modal fade" id="productDetailModal" tabindex="-1" aria-labelledby="productDetailModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="modalProductTitle">Chi Tiết Sản Phẩm</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <div class="row">

                        <!-- Hình sản phẩm -->
                        <div class="col-md-6 text-center">
                            <img id="modalProductImage" class="img-fluid rounded shadow-sm" />
                        </div>

                        <!-- Thông tin -->
                        <div class="col-md-6">

                            <div class="p-3 border rounded bg-light" style="min-height:120px;">
                                <p id="modalProductDescription" class="mb-0"></p>
                            </div>

                            <h4 id="modalProductPrice" class="mt-3 text-danger fw-bold"></h4>

                        </div>
                    </div>
                </div>

                <div class="modal-footer justify-content-between">

                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Đóng
                    </button>

                    <form method="post" asp-page="/Cart/Add" class="d-flex align-items-center gap-3">

                        <input type="hidden" id="modalItemId" name="ItemId" />

                        <div class="d-flex align-items-center">
                            <label class="me-2 fw-semibold">Số lượng:</label>
                            <input type="number"
                                   id="modalQuantity"
                                   name="Count"
                                   value="1"
                                   min="1"
                                   class="form-control text-center"
                                   style="width: 90px;">
                        </div>

                        <!-- Nút thêm -->
                        <button type="submit" class="btn btn-warning fw-semibold px-4">
                            Thêm vào giỏ hàng
                        </button>

                    </form>

                </div>

            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        let slideIndex = 0;
        showSlides();

        function showSlides() {
          let i;
          let slides = document.getElementsByClassName("banner-slide");

          if (slides.length === 0) return; // Dừng nếu không có slide

          for (i = 0; i < slides.length; i++) {
            slides[i].style.display = "none";
          }

          slideIndex++;
          if (slideIndex > slides.length) {slideIndex = 1}

          slides[slideIndex-1].style.display = "block";

          setTimeout(showSlides, 3000); // 3 giây
        }
    </script>

    <script>
        var productDetailModal = document.getElementById('productDetailModal');
        if (productDetailModal) {
            productDetailModal.addEventListener('show.bs.modal', function (event) {

                var card = event.relatedTarget;

                var title = card.getAttribute('data-product-title') || 'Chi tiết sản phẩm';
                var description = card.getAttribute('data-product-description') || '';
                var price = card.getAttribute('data-product-price') || '';
                var imageSrc = card.getAttribute('data-product-image') || '';

                // ⭐ LẤY ID SẢN PHẨM
                var id = card.getAttribute('data-product-id');

                // ⭐ GÁN VÀO HIDDEN INPUT CHO FORM
                document.getElementById("modalItemId").value = id;

                var modalTitle = productDetailModal.querySelector('#modalProductTitle');
                var modalImage = productDetailModal.querySelector('#modalProductImage');
                var modalDescription = productDetailModal.querySelector('#modalProductDescription');
                var modalPrice = productDetailModal.querySelector('#modalProductPrice');

                modalTitle.textContent = title;
                modalDescription.textContent = description;
                modalPrice.textContent = price;
                modalImage.src = imageSrc;
            });
        }
    </script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <form id="logoutForm" asp-controller="Account" asp-action="Logout" method="post" class="d-none">
        @* Nếu bạn dùng AntiForgery *@
        @Html.AntiForgeryToken()
    </form>
</body>
</html>
