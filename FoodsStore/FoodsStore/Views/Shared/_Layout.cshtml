<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>🍃 FoodMenu - Thực phẩm tươi ngon</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="~/css/site.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        /* Bảng màu: Primary #FF8A00 (Cam), Secondary #3C6E71 (Xanh Lục Bảo), Background #F7F7F7, Text #282C34 */

        body {
            background-color: #F7F7F7;
            font-family: 'Segoe UI', sans-serif;
            color: #282C34;
        }

        /* Header (Giữ màu Xanh Lục Bảo Đậm và Fixed) */
        .navbar {
            background-color: #3C6E71;
        }

        .navbar-brand {
            font-weight: bold;
            font-size: 1.5rem;
            color: #FF8A00 !important;
        }

        .nav-link.btn-auth {
            border: 1px solid white;
            border-radius: 8px;
            padding: 6px 16px;
            margin-left: 10px;
            color: white;
            font-weight: 500;
            transition: all 0.3s ease;
        }

            .nav-link.btn-auth:hover {
                background-color: #FF8A00;
                border-color: #FF8A00;
                color: white;
            }

        /* Khung lớn chứa nội dung (Container) - Viền nhẹ */
        .container {
            background-color: white;
            padding: 30px;
            border-radius: 12px;
            border: 2px solid #E0E0E0; /* Viền Xám Trắng nhẹ */
            box-shadow: 0 4px 12px rgba(40, 44, 52, 0.03);
        }

        footer {
            background-color: #3C6E71;
            color: #F7F7F7;
            padding: 20px;
            text-align: center;
            margin-top: 40px;
        }

        h2, h4 {
            color: #282C34;
        }

        .btn-success {
            background-color: #FF8A00;
            border-color: #FF8A00;
        }

            .btn-success:hover {
                background-color: #E57D00;
                border-color: #E57D00;
            }

        /* Thẻ thức ăn (Card) - Viền nhẹ */
        .card {
            background-color: white;
            border: 2px solid #E0E0E0; /* Viền Xám Trắng nhẹ */
            box-shadow: 0 4px 8px rgba(40, 44, 52, 0.05);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            border-radius: 12px;
        }

            .card:hover {
                transform: translateY(-5px);
                border-color: #FF8A00; /* Viền Cam Rực Rỡ khi hover */
                box-shadow: 0 8px 16px rgba(255, 138, 0, 0.2);
            }

        .card-img-top {
            height: 180px;
            object-fit: cover;
            border-top-left-radius: 9px;
            border-top-right-radius: 9px;
            border-bottom: 2px solid #FF8A00; /* Đường phân cách Cam Rực Rỡ */
        }

        /* CSS cho Slideshow Banner */
        .banner-slideshow-container {
            max-width: 100%;
            position: relative;
            margin: 2rem auto;
            overflow: hidden;
        }

        .banner-slide {
            display: none;
        }

        .banner-box {
            background-color: #A9ECCE;
            border: 2px dashed #FF8A00;
            border-radius: 12px;
            padding: 2rem;
            margin: 0;
            text-align: center;
            color: #282C34;
            font-size: 1.5rem;
            font-weight: 600;
        }

        .fade {
            animation-name: fade;
            animation-duration: 1.5s;
        }

        /* SỬA LỖI CÚ PHÁP RAZOR */
        @@keyframes fade {
            from {
                opacity: .4
            }

            to {
                opacity: 1
            }
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg px-4 fixed-top">
        <a class="navbar-brand" href="/">🍃 FoodMenu</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse justify-content-end" id="mainNavbar">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link btn-auth" href="/Account/Login">Đăng nhập</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link btn-auth" href="/Account/Register">Đăng ký</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link btn-auth" href="/Food/Cart">🛒 Giỏ hàng</a>
                </li>
            </ul>
        </div>
    </nav>

    <div class="container pt-5">

        <div class="banner-slideshow-container">
            <div class="banner-slide fade">
                <div class="banner-box">
                    Ưu đãi 1: **GIẢM GIÁ 30%** cho tất cả Salad tươi ngon! 🥗
                </div>
            </div>

            <div class="banner-slide fade">
                <div class="banner-box">
                    Ưu đãi 2: **MIỄN PHÍ VẬN CHUYỂN** cho đơn hàng trên 200K! 🛵
                </div>
            </div>

            <div class="banner-slide fade">
                <div class="banner-box">
                    Ưu đãi 3: Món mới ra mắt: **Bánh Ngũ Cốc Socola**! 🍫
                </div>
            </div>
        </div>

        @RenderBody()
    </div>

    <footer>
        © 2025 FoodMenu | Thực phẩm sạch - Tươi ngon mỗi ngày
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        let slideIndex = 0;
        showSlides();

        function showSlides() {
          let i;
          let slides = document.getElementsByClassName("banner-slide");

          for (i = 0; i < slides.length; i++) {
            slides[i].style.display = "none";
          }

          slideIndex++;
          if (slideIndex > slides.length) {slideIndex = 1}

          slides[slideIndex-1].style.display = "block";

          // Thiết lập thời gian 3000ms = 3 giây
          setTimeout(showSlides, 3000);
        }
    </script>
</body>
</html>