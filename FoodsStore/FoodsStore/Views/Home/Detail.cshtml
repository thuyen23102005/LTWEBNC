@model FoodsStore.Models.Item

<div class="container py-4">
    <div class="row">
        <div class="col-md-6">
            <img src="@Model.ImageUrl" class="img-fluid rounded" />
        </div>
        <div class="col-md-6">
            <h2>@Model.Title</h2>          
            <p>@Model.Description</p>
            <h4 class="text-success">@Model.Price.ToString("N0") VNĐ</h4>
        </div>
    </div>
</div>