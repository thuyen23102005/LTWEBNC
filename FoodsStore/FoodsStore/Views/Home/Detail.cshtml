@model FoodsStore.Models.FoodItem

<div class="container py-4">
    <div class="row">
        <div class="col-md-6">
            <img src="@Model.ImageUrl" class="img-fluid rounded" />
        </div>
        <div class="col-md-6">
            <h2>@Model.Name</h2>
            <p>@Model.Description</p>
            <h4 class="text-success">@Model.Price.ToString("N0") VNĐ</h4>
            <a href="@Url.Action("AddToCart", "Food", new { id = Model.Id })" class="btn btn-primary">Thêm vào giỏ hàng</a>
        </div>
    </div>
</div>