@model FoodsStore.Models.ViewModels.UserProfileVM

<div class="container my-4">
    <h3 class="fw-semibold mb-4">Thông Tin Người Dùng</h3>

    <div class="card mb-4">
        <div class="card-header">Thông Tin Cá Nhân</div>
        <div class="card-body">
            <p><strong>Họ tên:</strong> @Model.User.Name</p>
            <p><strong>Email:</strong> @Model.User.Email</p>
            <p><strong>Địa chỉ:</strong> @Model.User.Address</p>
            <p><strong>Thành phố:</strong> @Model.User.City</p>
            <p><strong>Mã bưu điện:</strong> @Model.User.PostalCode</p>

            <a asp-action="EditProfile" class="btn btn-primary">Chỉnh sửa thông tin</a>
        </div>
    </div>

    <h4 class="fw-semibold">Lịch Sử Mua Hàng</h4>

    @if (Model.Orders.Count == 0)
    {
        <p>Bạn chưa có đơn hàng nào.</p>
    }
    else
    {
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Mã đơn</th>
                    <th>Ngày đặt</th>
                    <th>Tổng tiền</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model.Orders)
                {
                    <tr>
                        <td>@order.Id</td>
                        <td>@order.OrderDate.ToShortDateString()</td>
                        <td>@order.OrderTotal.ToString("N0") đ</td>
                        <td>@order.OrderStatus</td>
                        <td>
                            <button type="button" class="btn btn-sm btn-info js-order-detail" data-order-id="@order.Id">
                                Xem chi tiết
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <!-- Modal chi tiết đơn hàng -->
    <div class="modal fade" id="orderDetailModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Chi tiết đơn hàng</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <div id="orderDetailContent">
                        Đang tải...
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const modalEl = document.getElementById('orderDetailModal');
                const modal = new bootstrap.Modal(modalEl);
                const contentEl = document.getElementById('orderDetailContent');

                document.querySelectorAll('.js-order-detail').forEach(btn => {
                    btn.addEventListener('click', function () {
                        const orderId = this.getAttribute('data-order-id');

                        contentEl.innerHTML = 'Đang tải...';

                        fetch(`/Orders/UserDetails/${orderId}`)
                            .then(r => {
                                if (!r.ok) throw new Error('Lỗi tải chi tiết đơn');
                                return r.text();
                            })
                            .then(html => {
                                contentEl.innerHTML = html;
                                modal.show();
                            })
                            .catch(err => {
                                contentEl.innerHTML = '<div class="text-danger">Không tải được chi tiết đơn hàng.</div>';
                                modal.show();
                                console.error(err);
                            });
                    });
                });
            });
        </script>
    }
</div>