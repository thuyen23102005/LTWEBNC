@model IEnumerable<FoodsStore.Models.ApplicationUser>

@{
    ViewData["Title"] = "Quản lý người dùng";
    // dùng layout admin cho giống trang quản lý sản phẩm
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

    var totalUsers = ViewBag.TotalUsers as int? ?? Model.Count();
    string search = ViewBag.Search as string ?? "";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-semibold mb-0">Danh sách người dùng</h3>

    <span class="badge bg-primary fs-6">
        Tổng số tài khoản: @totalUsers
    </span>
</div>

<form method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="search" class="form-control" placeholder="Tìm kiếm theo tên, email, username, thành phố..." value="@search" />

        <button class="btn btn-primary" type="submit">Tìm</button>

        @if (!string.IsNullOrWhiteSpace(search))
        {
            <a asp-action="Manage" class="btn btn-outline-secondary">
                Xóa lọc
            </a>
        }
    </div>
</form>

<table class="table table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>#</th>
            <th>Họ tên</th>
            <th>Email (UserName)</th>
            <th>Thành phố</th>
            <th>Địa chỉ</th>
            <th>Mã bưu điện</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @{
            var index = 1;
        }
        @foreach (var user in Model)
        {
            <tr>
                <td>@index</td>
                <td>@user.Name</td>
                <td>@user.UserName</td>
                <td>@user.City</td>
                <td>@user.Address</td>
                <td>@user.PostalCode</td>
                <td class="text-end">
                    <a asp-controller="Account" asp-action="ViewUser" asp-route-id="@user.Id"
                       class="btn btn-sm btn-outline-primary"> Xem
                    </a>
                </td>
            </tr>
            index++;
        }
    </tbody>
</table>