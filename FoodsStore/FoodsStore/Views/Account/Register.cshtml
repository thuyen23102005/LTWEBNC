@model FoodsStore.Models.Register

@{
    ViewBag.Title = "Đăng ký";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - FoodsStore</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FoodsStore.styles.css" asp-append-version="true" />

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        html, body {
            height: 100%;
        }

        body {
            background-image: url('/images/Br.jpg'); 
            background-attachment: fixed; 
            background-position: center;
            background-repeat: no-repeat;
            background-size: cover;
        }

        section {
            display: flex;
            justify-content: center;
            align-items: center;
            width: 100%;
            min-height: 100vh;
            padding: 20px;
        }

        .register-box {
            position: relative;
            width: 400px;
            background: transparent;
            border: 2px solid rgba(255, 255, 255, .5);
            border-radius: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            backdrop-filter: blur(15px);
            padding: 20px 30px;
        }

        h2 {
            font-size: 2em;
            color: #fff;
            text-align: center;
        }

        .input-box {
            position: relative;
            width: 310px;
            margin: 30px 0;
            border-bottom: 2px solid #fff;
        }

            .input-box label {
                position: absolute;
                top: 50%;
                left: 5px;
                transform: translateY(-50%);
                font-size: 1em;
                color: #fff;
                pointer-events: none;
                transition: .5s;
            }

            .input-box input:focus ~ label,
            .input-box input:valid ~ label {
                top: -5px;
            }

            .input-box input {
                width: 100%;
                height: 50px;
                background: transparent;
                border: none;
                outline: none;
                font-size: 1em;
                color: #fff;
                padding: 0 35px 0 5px;
            }

            .input-box .icon {
                position: absolute;
                right: 8px;
                color: #fff;
                font-size: 1.2em;
                line-height: 57px;
            }

        button {
            width: 100%;
            height: 40px;
            background: #fff;
            border-radius: 40px;
            border: none;
            outline: none;
            cursor: pointer;
            font-size: 1em;
            color: #000;
            font-weight: 500;
        }

        .login-link {
            font-size: .9em;
            color: #fff;
            text-align: center;
            margin: 25px 0 10px;
        }

            .login-link p a {
                color: #fff;
                text-decoration: none;
                font-weight: 600;
            }

                .login-link p a:hover {
                    text-decoration: underline;
                }

        
        .text-danger {
            color: #ffcccc; 
            font-size: 0.9em;
            padding-top: 5px;
            display: block; 
        }

    </style>
</head>
<body>
    <section>
        <div class="register-box">
            @using (Html.BeginForm("Register", "Account", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <h2>Đăng ký</h2>

                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <!-- Tài khoản -->
                <div class="input-box">
                    <span class="icon"><ion-icon name="person"></ion-icon></span>
                    @Html.TextBoxFor(m => m.UserName, new { required = "required" })
                    <label>Tài khoản</label>
                    @Html.ValidationMessageFor(model => model.UserName, "", new { @class = "text-danger" })
                </div>

                <!-- Họ và tên (Name) -->
                <div class="input-box">
                    <span class="icon"><ion-icon name="person-circle-outline"></ion-icon></span>
                    @Html.TextBoxFor(m => m.Name, new { required = "required" })
                    <label>Họ và tên</label>
                    @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                </div>

                <!-- Thành phố (City) -->
                <div class="input-box">
                    <span class="icon"><ion-icon name="location-outline"></ion-icon></span>
                    @Html.TextBoxFor(m => m.City, new { required = "required" })
                    <label>Thành phố</label>
                    @Html.ValidationMessageFor(model => model.City, "", new { @class = "text-danger" })
                </div>

                <!-- Địa chỉ (Address) -->
                <div class="input-box">
                    <span class="icon"><ion-icon name="home-outline"></ion-icon></span>
                    @Html.TextBoxFor(m => m.Address, new { required = "required" })
                    <label>Địa chỉ</label>
                    @Html.ValidationMessageFor(model => model.Address, "", new { @class = "text-danger" })
                </div>

                <!-- Mã bưu điện (PostalCode) -->
                <div class="input-box">
                    <span class="icon"><ion-icon name="mail-open-outline"></ion-icon></span>
                    @Html.TextBoxFor(m => m.PostalCode, new { required = "required" })
                    <label>Mã bưu điện</label>
                    @Html.ValidationMessageFor(model => model.PostalCode, "", new { @class = "text-danger" })
                </div>

                <!-- Mật khẩu -->
                <div class="input-box">
                    <span class="icon"><ion-icon name="lock-closed"></ion-icon></span>
                    @Html.PasswordFor(m => m.Password, new { required = "required", id = "registerPassword" })
                    <label>Mật khẩu</label>
                    <span class="icon" style="right: 35px; cursor: pointer;"
                          onclick="togglePassword('registerPassword', 'eyeIcon1')">
                        <ion-icon id="eyeIcon1" name="eye-off-outline"></ion-icon>
                    </span>
                    @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })
                </div>

                <!-- Xác nhận mật khẩu -->
                <div class="input-box">
                    <span class="icon"><ion-icon name="lock-closed"></ion-icon></span>
                    @Html.PasswordFor(m => m.ConfirmPassword, new { required = "required", id = "confirmPassword" })
                    <label>Xác nhận mật khẩu</label>
                    <span class="icon" style="right: 35px; cursor: pointer;"
                          onclick="togglePassword('confirmPassword', 'eyeIcon2')">
                        <ion-icon id="eyeIcon2" name="eye-off-outline"></ion-icon>
                    </span>
                    @Html.ValidationMessageFor(model => model.ConfirmPassword, "", new { @class = "text-danger" })
                </div>

                <button type="submit">Đăng ký</button>

                <div class="login-link">
                    <p>Đã có tài khoản? <a href="@Url.Action("Login", "Account")">Đăng nhập</a></p>
                </div>
            }
        </div>
    </section>

    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>

    <script>
        function togglePassword(inputId, iconId) {
            const passwordInput = document.getElementById(inputId);
            const eyeIcon = document.getElementById(iconId);

            if (passwordInput.type === "password") {
                passwordInput.type = "text";
                eyeIcon.name = "eye-outline";
            } else {
                passwordInput.type = "password";
                eyeIcon.name = "eye-off-outline";
            }
        }
    </script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
</body>
</html>