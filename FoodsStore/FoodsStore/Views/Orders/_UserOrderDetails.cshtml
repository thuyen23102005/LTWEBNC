@model FoodsStore.Models.ViewModels.OrderDetailsVM
@{
    Layout = null;   // rất quan trọng: không dùng layout admin/user
}

<div>
    <h5 class="mb-3">Đơn hàng #@Model.OrderHeader.Id</h5>

    <p><strong>Ngày đặt:</strong> @Model.OrderHeader.OrderDate.ToShortDateString()</p>
    <p><strong>Trạng thái:</strong> @Model.OrderHeader.OrderStatus</p>
    <p><strong>Tổng tiền:</strong> @Model.OrderHeader.OrderTotal.ToString("N0") đ</p>

    <hr />

    <h6>Sản phẩm trong đơn</h6>
    <table class="table table-sm table-bordered mt-2">
        <thead>
            <tr>
                <th>Tên món</th>
                <th>Số lượng</th>
                <th>Đơn giá</th>
                <th>Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model.OrderDetails)
            {
                var lineTotal = d.Price * d.Count;
                <tr>
                    <td>@d.Name</td>
                    <td>@d.Count</td>
                    <td>@d.Price.ToString("N0") đ</td>
                    <td>@lineTotal.ToString("N0") đ</td>
                </tr>
            }
        </tbody>
    </table>
</div>
