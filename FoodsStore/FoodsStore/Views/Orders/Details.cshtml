@model FoodsStore.Models.OrderHeader

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Chi tiết đơn hàng";
}

<h2>Chi tiết đơn hàng #@Model.Id</h2>

<div class="card mb-4">
    <div class="card-body">
        <p><strong>Người đặt:</strong> @Model.Name</p>
        <p><strong>Số điện thoại:</strong> @Model.Phone</p>
        <p><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy")</p>
        <p><strong>Trạng thái:</strong> @Model.OrderStatus</p>
        <p><strong>Tổng tiền:</strong> @Model.OrderTotal.ToString("N0") ₫</p>
    </div>
</div>

<h4>Sản phẩm trong đơn</h4>
<table class="table table-hover table-bordered">
    <thead>
        <tr>
            <th>Tên món</th>
            <th>Mô tả</th>
            <th>Số lượng</th>
            <th>Đơn giá</th>
            <th>Thành tiền</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in ViewBag.OrderDetails as List<FoodsStore.Models.OrderDetails>)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Description</td>
                <td>@item.Count</td>
                <td>@item.Price.ToString("N0") ₫</td>
                <td>@((item.Price * item.Count).ToString("N0")) đ</td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Index" class="btn btn-secondary">Quay lại</a>
