@page
@model FoodsStore.Pages.Cart.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Giỏ Hàng Của Bạn";
}

<div class="container cart-page my-4">
    <h3 class="fw-semibold mb-4">🛒 Giỏ Hàng Của Bạn</h3>

    @* ==== LAYOUT KHI KHÔNG CÓ HÀNG ==== *@
    @if (Model.Lines == null || Model.Lines.Count == 0)
    {
        <div class="empty-cart d-flex flex-column align-items-center text-center py-5">
            <img src="~/images/items/cart_empty.png" alt="Giỏ hàng trống"
                 class="empty-illustration mb-3" />
            <h4 class="fw-semibold mb-2">“Hổng” có gì trong giỏ hết</h4>
            <p class="text-muted mb-4">
                Về trang cửa hàng để chọn mua sản phẩm bạn nhé!!
            </p>
            <a asp-page="/Items/Index" class="btn btn-outline-primary btn-lg px-4">
                Mua sắm ngay
            </a>
        </div>

        <hr class="my-5" />
    }
    else
    {
        @* ==== LAYOUT KHI CÓ HÀNG ==== *@
        <div class="row g-4">
            <!-- LEFT: bảng sản phẩm -->
            <div class="col-12 col-lg-8">
                <div class="card shadow-sm">
                    <div class="card-header bg-white fw-semibold">
                        Sản phẩm trong giỏ hàng
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:40px;">
                                            <input class="form-check-input" type="checkbox" disabled />
                                        </th>
                                        <th>Sản Phẩm</th>
                                        <th class="text-end">Đơn Giá</th>
                                        <th class="text-center" style="width:180px;">Số Lượng</th>
                                        <th class="text-end">Thành Tiền</th>
                                        <th class="text-center" style="width:90px;">Thao Tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var l in Model.Lines)
                                    {
                                        <tr>
                                            <td>
                                                <input class="form-check-input" type="checkbox" checked />
                                            </td>
                                            <td class="d-flex align-items-center gap-3">
                                                <img src="~/images/items/@(l.ItemId).png"
                                                     onerror="this.src='@Url.Content("~/images/placeholder.png")';"
                                                     class="rounded" style="width:56px;height:56px;object-fit:cover;" alt="item" />
                                                <div class="fw-semibold">@l.Title</div>
                                            </td>
                                            <td class="text-end">@Model.ToCurrency(l.Price)</td>
                                            <td class="text-center">
                                                <div class="btn-group" role="group">
                                                    <form method="post" asp-page-handler="Update">
                                                        <input type="hidden" name="itemId" value="@l.ItemId" />
                                                        <input type="hidden" name="count" value="@(l.Count - 1)" />
                                                        <button class="btn btn-outline-secondary px-2" @(l.Count <= 1 ? "disabled" : "")>-</button>
                                                    </form>
                                                    <input type="number" min="1" class="form-control text-center"
                                                           style="width:64px;border-left:0;border-right:0;"
                                                           value="@l.Count"
                                                           onkeydown="return event.key!=='Enter';"
                                                           onchange="document.getElementById('qty-@l.ItemId').value=this.value; document.getElementById('form-@l.ItemId').submit();" />
                                                    <form id="form-@l.ItemId" method="post" asp-page-handler="Update">
                                                        <input type="hidden" id="qty-@l.ItemId" name="count" value="@l.Count" />
                                                        <input type="hidden" name="itemId" value="@l.ItemId" />
                                                    </form>
                                                    <form method="post" asp-page-handler="Update">
                                                        <input type="hidden" name="itemId" value="@l.ItemId" />
                                                        <input type="hidden" name="count" value="@(l.Count + 1)" />
                                                        <button class="btn btn-outline-secondary px-2">+</button>
                                                    </form>
                                                </div>
                                            </td>
                                            <td class="text-end fw-semibold text-danger">
                                                @Model.ToCurrency(l.LineTotal)
                                            </td>
                                            <td class="text-center">
                                                <form method="post" asp-page-handler="Delete">
                                                    <input type="hidden" name="itemId" value="@l.ItemId" />
                                                    <button class="btn btn-sm btn-danger">Xóa</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- RIGHT: mã giảm giá & tổng -->
            <div class="col-12 col-lg-4">
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-white fw-semibold">
                        Mã giảm giá
                    </div>
                    <div class="card-body">
                        <form method="post" asp-page-handler="ApplyCoupon" class="d-flex gap-2">
                            <input name="coupon" class="form-control" placeholder="VD: WELCOME10" />
                            <button class="btn btn-outline-primary">Áp dụng</button>
                        </form>
                        <a href="#" class="btn btn-sm btn-outline-info mt-2">🎁 Xem tất cả mã giảm giá</a>
                    </div>
                </div>

                <div class="card shadow-sm">
                    <div class="card-header bg-white fw-semibold">
                        Tổng thanh toán
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Tổng tiền hàng:</span>
                            <span>@Model.ToCurrency(Model.SubTotal)</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span>Giảm giá:</span>
                            <span>-@Model.ToCurrency(Model.Discount)</span>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between fs-5 fw-bold text-danger mb-3">
                            <span>Tổng cộng:</span>
                            <span>@Model.ToCurrency(Model.GrandTotal)</span>
                        </div>
                        <a asp-page="/Checkout/Index" class="btn btn-primary w-100">
                            Tiến hành thanh toán
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>