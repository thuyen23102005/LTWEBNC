@page
@model FoodsStore.Pages.Cart.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Giỏ Hàng Của Bạn";
}

<div class="container cart-page my-4">
    <h3 class="fw-semibold mb-4">🛒 Giỏ Hàng Của Bạn</h3>

    @* ==== KHI GIỎ TRỐNG ==== *@
    @if (Model.Lines == null || Model.Lines.Count == 0)
    {
        <div class="empty-cart d-flex flex-column align-items-center text-center py-5">
            <img src="~/images/items/cart_empty.png" alt="Giỏ hàng trống"
                 class="empty-illustration mb-3" />
            <h4 class="fw-semibold mb-2">“Hổng” có gì trong giỏ hết</h4>
            <p class="text-muted mb-4">
                Về trang cửa hàng để chọn mua sản phẩm bạn nhé!!
            </p>
            <a href="/" class="btn btn-outline-primary btn-lg px-4">
                Mua sắm ngay
            </a>
        </div>

        <hr class="my-5" />
    }
    else
    {
        @* ==== KHI GIỎ CÓ HÀNG ==== *@
        <div class="row g-4 align-items-start">
            <!-- LEFT: bảng sản phẩm -->
            <div class="col-12 col-lg-8">
                <div class="card shadow-sm">
                    <div class="card-header bg-white fw-semibold">
                        Sản phẩm trong giỏ hàng
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:40px;">
                                            <input class="form-check-input" type="checkbox" id="masterCheckbox" checked />
                                        </th>
                                        <th>Sản Phẩm</th>
                                        <th class="text-end">Đơn Giá</th>
                                        <th class="text-center" style="width:180px;">Số Lượng</th>
                                        <th class="text-end">Thành Tiền</th>
                                        <th class="text-center" style="width:90px;">Thao Tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var l in Model.Lines)
                                    {
                                        <tr>
                                            <td>
                                                <input class="form-check-input item-checkbox" type="checkbox" checked value="@l.ItemId" data-price="@l.LineTotal" />
                                            </td>

                                            <td class="d-flex align-items-center gap-3">
                                                <img src="@Url.Content(l.ImageUrl ?? $"/images/items/{l.ItemId}.png")"
                                                     onerror="this.onerror=null;this.src='/images/placeholder.png';"
                                                     style="width:56px;height:56px;object-fit:cover"
                                                     class="rounded"
                                                     alt="@l.Title" />
                                                <div class="fw-semibold">@l.Title</div>
                                            </td>

                                            <td class="text-end">@Model.ToCurrency(l.Price)</td>

                                            @* --- Cột SỐ LƯỢNG --- *@
                                            <td class="text-center">
                                                <div class="btn-group" role="group">
                                                    @* Nút giảm *@
                                                    <form method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit"
                                                                class="btn btn-outline-secondary btn-sm"
                                                                formaction="/Cart/Index?handler=Update&itemId=@l.ItemId&count=@(Math.Max(1, l.Count - 1))"
                                                                @(l.Count <= 1 ? "disabled" : "")>
                                                            -
                                                        </button>
                                                    </form>

                                                    <input type="text"
                                                           readonly
                                                           class="form-control form-control-sm text-center"
                                                           style="width:60px"
                                                           value="@l.Count" />

                                                    @* Nút tăng *@
                                                    <form method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit"
                                                                class="btn btn-outline-secondary btn-sm"
                                                                formaction="/Cart/Index?handler=Update&itemId=@l.ItemId&count=@(l.Count + 1)">
                                                            +
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>

                                            @* --- Cột THÀNH TIỀN --- *@
                                            <td class="text-end">
                                                @Model.ToCurrency(l.LineTotal)
                                            </td>

                                            @* --- Cột THAO TÁC (Xóa) --- *@
                                            <td class="text-center">
                                                <form method="post">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit"
                                                            class="btn btn-sm btn-danger"
                                                            formaction="/Cart/Index?handler=Delete&itemId=@l.ItemId">
                                                        Xóa
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- RIGHT: tóm tắt thanh toán -->
            <div class="col-12 col-lg-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-white fw-semibold">
                        Tổng thanh toán
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Tổng tiền hàng:</span>
                            <span>@Model.ToCurrency(Model.SubTotal)</span>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between fs-5 fw-bold text-danger mb-3">
                            <span>Tổng cộng:</span>
                            <span id="displayTotal">@Model.ToCurrency(Model.GrandTotal)</span>
                        </div>
                        
                        <!-- Nút chuyển sang trang thanh toán -->
                        @if (User.Identity.IsAuthenticated)
                        {
                            <!-- ĐÃ ĐĂNG NHẬP: cho đi checkout -->
                            <a href="#" onclick="goToCheckout(event)" class="btn btn-primary w-100">
                                Tiến hành thanh toán
                            </a>
                        }
                        else
                        {
                            <!-- CHƯA ĐĂNG NHẬP: bắt đăng nhập trước -->
                            <a href="/Account/Login?returnUrl=/Cart/Checkout" class="btn btn-primary w-100">
                                Đăng nhập để thanh toán
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const masterCheckbox = document.getElementById("masterCheckbox");
            const itemCheckboxes = document.querySelectorAll(".item-checkbox");
            const displayTotal = document.getElementById("displayTotal");

            // Hàm định dạng tiền tệ VNĐ
            const formatter = new Intl.NumberFormat('vi-VN', {
                style: 'currency',
                currency: 'VND'
            });

            // 1. Hàm tính lại tổng tiền
            function updateTotalPrice() {
                let total = 0;
                itemCheckboxes.forEach(checkbox => {
                    if (checkbox.checked) {
                        // Lấy giá trị từ data-price mà ta đã gán ở Bước 1
                        total += parseFloat(checkbox.getAttribute("data-price"));
                    }
                });
                displayTotal.textContent = formatter.format(total);
            }

            // 2. Hàm kiểm tra trạng thái Master Checkbox
            function updateMasterCheckboxState() {
                // Kiểm tra xem có bao nhiêu ô đang được check
                const allChecked = Array.from(itemCheckboxes).every(cb => cb.checked);
                masterCheckbox.checked = allChecked;
            }

            // --- GÁN SỰ KIỆN ---

            // A. Khi bấm vào nút Master (Chọn tất cả)
            masterCheckbox.addEventListener("change", function () {
                const isChecked = this.checked;
                itemCheckboxes.forEach(checkbox => {
                    checkbox.checked = isChecked;
                });
                updateTotalPrice();
            });

            // B. Khi bấm vào từng nút con
            itemCheckboxes.forEach(checkbox => {
                checkbox.addEventListener("change", function () {
                    updateTotalPrice();        // Tính lại tiền
                    updateMasterCheckboxState(); // Kiểm tra để bật/tắt nút Master
                });
            });
        });

            // Chuyển hướng sang trang Checkout với các ID đã chọn
        function goToCheckout(e) {
            e.preventDefault();

            // Lấy tất cả checkbox đang được tick
            const selectedCheckboxes = document.querySelectorAll('.item-checkbox:checked');

            if (selectedCheckboxes.length === 0) {
                alert("Vui lòng chọn ít nhất 1 sản phẩm để thanh toán!");
                return;
            }

            // Tạo URL có chứa tham số selectedIds
            let url = "/Cart/Checkout?";
            selectedCheckboxes.forEach((cb, index) => {
                if (index > 0) url += "&";
                url += `selectedIds=${cb.value}`;
            });

            // Chuyển trang
            window.location.href = url;
        }
    </script>
}