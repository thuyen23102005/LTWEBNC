@page
@model Microsoft.AspNetCore.Mvc.RazorPages.PageModel
@{
    ViewData["Title"] = "Thanh toán thành công";
}

<div class="container my-5 text-center">
    <h2 class="fw-semibold mb-3">🎉 Thanh toán thành công!</h2>
    <p class="text-muted mb-4">
        Cảm ơn bạn đã mua hàng. Đơn của bạn đang được xử lý.
    </p>

    @if (TempData["Toast"] is string msg)
    {
        <div class="alert alert-success d-inline-block px-4 py-2" role="alert">
            @msg
        </div>
    }

    <div class="mt-4">
        <a asp-page="/Items/Index" class="btn btn-outline-primary me-2">Tiếp tục mua sắm</a>
        <a asp-page="/Cart/Index" class="btn btn-link">Xem giỏ hàng</a>
    </div>
</div>